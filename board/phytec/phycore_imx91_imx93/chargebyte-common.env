bootcmd=
	mmc dev ${mmcdev};
	if mmc rescan; then
		run mmcboot;
	else
		run netboot;
	fi;
image=Image
console=ttyLP0
fdt_addr_r=0x90000000
fdtoverlay_addr_r=0x900c0000
bootenv_addr_r=0x90500000
fdtfile=CONFIG_DEFAULT_FDT_FILE
ipaddr=192.168.3.11
serverip=192.168.3.10
netmask=255.255.255.0
ip_dyn=no
bootenv=bootenv.txt
optargs=cpuidle.off=1
prepare_mcore=setenv optargs "${optargs} clk-imx93.mcore_booted"
mmc_load_bootenv=load mmc ${mmcdev}:${mmcpart} ${bootenv_addr_r} /boot/${bootenv}
mmc_load_overlay=load mmc ${mmcdev}:${mmcpart} ${fdtoverlay_addr_r} /boot/${overlay}
mmc_apply_overlays=
	fdt address ${fdt_addr_r};
	if test ${no_overlays} = 0; then
		for overlay in ${overlays}; do;
			if run mmc_load_overlay; then
				fdt resize ${filesize};
				fdt apply ${fdtoverlay_addr_r};
			fi;
		done;
	fi;
cb_eeprom_bus=0
cb_eeprom_addr=0x50
cb_eeprom_chunk=0x100
apply_eeprom_dtbo=
	if test ${no_eeprom_dtbo} = 0; then
		i2c dev ${cb_eeprom_bus};
		if i2c read ${cb_eeprom_addr} 0.2 0x40 ${fdtoverlay_addr_r}; then
			setexpr offset_addr_r ${fdtoverlay_addr_r} + 0x4;
			setexpr length_addr_r ${fdtoverlay_addr_r} + 0x6;
			setexpr crc_expected_addr_r ${fdtoverlay_addr_r} + 0x3c;
			setexpr.l crc_expected *${crc_expected_addr_r};
			if crc32 -v ${fdtoverlay_addr_r} 0x3c ${crc_expected}; then
				setexpr.w offset *${offset_addr_r};
				setexpr.w length *${length_addr_r};
				setexpr loadaddr_r ${fdtoverlay_addr_r};
				setexpr tmplength ${length} + ${cb_eeprom_chunk};
				setexpr tmplength ${tmplength} - 1;
				setexpr count ${tmplength} / ${cb_eeprom_chunk};
				setexpr i 0;
				while test ${i} -lt ${count}; do
					i2c read ${cb_eeprom_addr} ${offset}.2 ${cb_eeprom_chunk} ${loadaddr_r};
					setexpr offset ${offset} + ${cb_eeprom_chunk};
					setexpr loadaddr_r ${loadaddr_r} + ${cb_eeprom_chunk};
					setexpr i ${i} + 1;
				done;
				echo "Carrier Board EEPROM DT Overlay loaded";
				fdt address ${fdt_addr_r};
				fdt resize ${length};
				if fdt apply ${fdtoverlay_addr_r}; then
					echo "Carrier Board EEPROM DT Overlay applied";
				else
					echo "Error: could not apply Carrier Board EEPROM DT Overlay";
				fi;
			else
				echo "Error: Carrier Board EEPROM CRC Check FAILED - skipped DT Overlay loading";
			fi;
		else
			echo "Error: reading Carrier Board EEPROM failed";
		fi;
	else
		echo "Carrier Board EEPROM DT Overlay disabled";
	fi;
emmc_dev=0
mmcdev=CONFIG_SYS_MMC_ENV_DEV
mmcpart=1
mmcroot=/dev/mmcblk0p1
mmcargs=setenv bootargs ${bootargs} ${optargs} console=${console},${baudrate} earlycon panic=1
common_mmcargs=rootfstype=ext4 rootwait
loadimage=load mmc ${mmcdev}:${mmcpart} ${loadaddr} /boot/${image}
loadfdt=load mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} /boot/${fdtfile}
no_bootenv=1
no_overlays=0
no_eeprom_dtbo=0
mmcboot=
	echo Booting from mmc ...;
	if test ${no_bootenv} = 0; then
		if run mmc_load_bootenv; then
			env import -t ${bootenv_addr_r} ${filesize};
		fi;
	fi;
	test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B";
	test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3;
	test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3;
	setenv bootargs;
	for BOOT_SLOT in "${BOOT_ORDER}"; do
		if test "x${bootargs}" != x; then
			;
		elif test x${BOOT_SLOT} = xA; then
			if test ${BOOT_A_LEFT} -gt 0; then
				setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1;
				echo "Found valid slot A, ${BOOT_A_LEFT} attempts remaining";
				setenv mmcpart 1;
				setenv mmcroot /dev/mmcblk0p${mmcpart};
				setenv bootargs ${common_mmcargs} root=${mmcroot} rauc.slot=A;
			fi;
		elif test "x${BOOT_SLOT}" = xB; then
			if test ${BOOT_B_LEFT} -gt 0; then
				setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1;
				echo "Found valid slot B, ${BOOT_B_LEFT} attempts remaining";
				setenv mmcpart 2;
				setenv mmcroot /dev/mmcblk0p${mmcpart};
				setenv bootargs ${common_mmcargs} root=${mmcroot} rauc.slot=B;
			fi;
		fi;
	done;
	if test -n "${bootargs}"; then
		saveenv;
	else
		echo "No valid slot found, resetting tries to 3";
		setenv BOOT_A_LEFT 3;
		setenv BOOT_B_LEFT 3;
		saveenv;
		reset;
	fi;
	run mmcargs;
	run loadimage;
	if run loadfdt; then
		run apply_eeprom_dtbo;
		run mmc_apply_overlays;
		booti ${loadaddr} - ${fdt_addr_r};
	else
		echo WARN: Cannot load the DT;
	fi;
BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=3
